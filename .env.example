# StageGate reads only these environment variables. None are required.

# Kill switch (see README "Kill switch precedence").
# Any of: 1 true yes on trip tripped stop  -> TRIPPED
# Any of: 0 false no off ""                -> abstain (does NOT clear a file sentinel)
# Anything else                            -> TRIPPED (unparseable input fails closed)
STAGEGATE_KILL=

# Path to the file sentinel. If this file EXISTS, the switch is tripped and its
# first line is recorded in the audit log as the reason.
STAGEGATE_KILL_FILE=/var/run/stagegate/kill

# Salt for redaction fingerprints. Required before RedactionPolicy(fingerprint=True)
# will emit correlatable hashes; without it, fingerprinting refuses to run rather
# than emit brute-forceable digests of low-entropy values (SSNs, phone numbers).
STAGEGATE_REDACTION_SALT=

# Optional actor identity recorded on audit events when no actor is supplied.
STAGEGATE_ACTOR=
